# Copy to config/secrets.env and fill in. NEVER commit secrets.env.
# Unused for live market data (no paid data subscription on this account) —
# kept only for KiteOMS, dormant Phase-3 order-execution code.
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# ICICI Breeze — the real-time market-data source. Session token expires
# daily; refresh via the /breeze_token Telegram command.
ICICI_BREEZE_API_KEY=
ICICI_BREEZE_API_SECRET=
ICICI_BREEZE_SESSION_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POSTGRES_URL=postgresql+psycopg2://quntra:quntra_dev@localhost:5432/quntra
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_QSA_URL=
MLFLOW_TRACKING_URI=
# Optional: enables Claude-backed /chat answers. Without it, /chat falls
# back to deterministic memory recall. Key from console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: where the Obsidian markdown vault is written (default
# data/obsidian_vault). Point Obsidian at this folder to browse QuNtra's
# memory. Obsidian is free for personal use.
OBSIDIAN_VAULT_DIR=
# Optional: NewsAPI.org second news source (free tier: 100 req/day). Key
# from newsapi.org/register. Blank -> RSS-only, no crash either way.
NEWSAPI_KEY=
